@@ -129,6 +129,7 @@ struct mmc_host_ops {
 
 	int	(*start_signal_voltage_switch)(struct mmc_host *host);
 	int	(*get_max_current_180)(struct mmc_host *mmc);
+	void	(*execute_tuning)(struct mmc_host *host);
 };
 
 struct mmc_card;
